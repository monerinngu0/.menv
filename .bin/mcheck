#!/usr/bin/env bash
set -e

MENV_ROOT="${MENV_ROOT:-$HOME/.menv}"

if ! command -v python3 >/dev/null 2>&1; then
    echo "mcheck: python3 is required; install it manually." >&2
    exit 1
fi

if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
    echo "mcheck: Python 3.11 or newer is required; update it manually." >&2
    exit 1
fi

exec python3 "$MENV_ROOT/.lib/mcheck.py" "$@"
