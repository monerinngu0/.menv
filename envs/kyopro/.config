[defaults]
site = "atcoder"
language = "cpp"

[knew]
download_samples = true

[testing]
timeout = 2.0

[ksub]
test_before_submit = false

[cpp]
build_command = [
    "gpp",
    "{source}",
    "-o",
    "{output}",
]

run_command = [
    "{output}",
]

include_dirs = []

[python]
run_command = [
    "python3",
    "{source}",
]